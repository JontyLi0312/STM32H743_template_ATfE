{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "probe-rs",
            "probe": "0483:3748",
            "wireProtocol": "Swd",
            "chip": "STM32H743IIT6",
            "flashingConfig": {
                "flashingEnabled": true,
                "formatOptions": {},
                "haltAfterReset": false
            },
            "runtimeArgs": [
                "dap-server"
            ],
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "build\\Debug\\STM32H743IIT6.elf"
                }
            ],
            "env": {
                "RUST_LOG": "Debug"
            }
        },
        {
            "cwd": "${workspaceRoot}",
            "type": "cortex-debug",
            "request": "launch",
            "name": "OpenOCD_cmsis-dap",
            "servertype": "openocd",
            "executable": "./build/Debug/STM32H743IIT6.elf",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "svdFile": ".STM32H743.svd",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32h7x.cfg"
            ],
            "toolchainPrefix": "arm-none-eabi"
        },
        {
            "cwd": "${workspaceRoot}",
            "type": "cortex-debug",
            "request": "launch",
            "name": "OpenOCD_stlink",
            "servertype": "openocd",
            "executable": "./build/Debug/STM32H743IIT6.elf",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "svdFile": ".STM32H743.svd",
            "configFiles": [
                "interface/stlink-v2.cfg",
                "target/stm32h7x.cfg"
            ],
            "toolchainPrefix": "arm-none-eabi"
        }
    ]
}