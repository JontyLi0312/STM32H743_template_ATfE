{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "probe-rs",
            "probe": "04d8:000df",
            "chip": "STM32H743IITx",
            "connectUnderReset": false,
            "wireProtocol": "Swd",
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": false
            },
            "runtimeArgs": [
                "dap-server"
            ],
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "build/Debug/STM32H743IIT6.elf",
                    "svdFile": ".conf/STM32H743.svd",
                }
            ],
            "env": {
                "RUST_LOG": "Debug"
            }
        },
        {
            "name": "openocd_CMSIS-DAP",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "showDevDebugOutput": "raw",
            "cwd": "${workspaceRoot}",
            "executable": "build/Debug/internal.elf",
            "svdFile": ".conf/STM32H743.svd",
            "runToEntryPoint": "main",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32h7x.cfg"
            ],
            "toolchainPrefix": "arm-none-eabi"
        },
        {
            "name": "openocd_ST-Link",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceRoot}",
            "showDevDebugOutput": "raw",
            "executable": "build/Debug/internal.elf",
            "svdFile": ".conf/STM32H743.svd",
            "runToEntryPoint": "main",
            "configFiles": [
                "interface/stlink-v2.cfg",
                "target/stm32h7x.cfg"
            ],
            "toolchainPrefix": "arm-none-eabi"
        },
        {
            "name": "pyOCD",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "pyocd",
            "showDevDebugOutput": "raw",
            "cwd": "${workspaceFolder}",
            "targetId": "STM32H743IITX",
            "interface": "swd",
            "executable": "build/Debug/internal.elf",
            "svdFile": ".conf/STM32H743.svd",
            "runToEntryPoint": "main",
            "serverArgs": [
                "--script=${workspaceFolder}/pyocd_user.py"
            ]
        }
    ]
}