{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "buildType",
            "type": "pickString",
            "description": "Please select the build type to use",
            "options": [
                "Debug",
                "Release"
            ],
            "default": "Debug"
        }
    ],
    "tasks": [
        // ==================== Basic Tasks (Driven by Input) ====================
        {
            "label": "🔧 Configure",
            "detail": "Configure CMake build environment",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "${input:buildType}"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "🔨 Build",
            "detail": "Build the project",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "${input:buildType}"
            ],
            "dependsOn": "🔧 Configure",
            "group": "build"
        },
        {
            "label": "🧹 Clean",
            "detail": "Clean the build files",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/${input:buildType}",
                "--target",
                "clean"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "📥 Flash (OpenOCD)",
            "detail": "Flash firmware using OpenOCD",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/stm32h7x.cfg",
                "-c",
                "program ./build/${input:buildType}/STM32H743IIT6.elf verify reset exit"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "📥 Flash (pyOCD)",
            "detail": "Flash firmware using pyOCD",
            "type": "shell",
            "command": "pyocd",
            "args": [
                "flash",
                "-t",
                "stm32h743xx",
                "build/${input:buildType}/STM32H743IIT6.elf"
            ],
            "group": "build",
            "problemMatcher": []
        },
        // ==================== Composite Workflow Tasks ====================
        {
            "label": "🚀 Clean + Build",
            "detail": "Full Workflow: Clean, Build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "🧹 Clean",
                "🔨 Build",
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "🚀🚀 Clean + Build + Flash (OpenOCD)",
            "detail": "Full Workflow: Clean, Build and Flash using OpenOCD",
            "dependsOrder": "sequence",
            "dependsOn": [
                "🧹 Clean",
                "🔨 Build",
                "📥 Flash (OpenOCD)"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "🚀🚀 Clean + Build + Flash (pyOCD)",
            "detail": "Full Workflow: Clean, Build and Flash using pyOCD",
            "dependsOrder": "sequence",
            "dependsOn": [
                "🧹 Clean",
                "🔨 Build",
                "📥 Flash (pyOCD)"
            ],
            "group": "build",
            "problemMatcher": []
        },
    ]
}